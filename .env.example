# =======================================================================
# LodgeTrack Scout / Growth — environment reference (v2, PLAN §12)
# Every key optional unless stated. Missing credentials → dry/dormant
# mode. Secrets NEVER live in the repo; file must be chmod 600 on box.
# =======================================================

# ---- Telegram (P0: @BotFather token; DM the bot /start from the private chat) ----
SCOUT_TELEGRAM_BOT_TOKEN=
SCOUT_TELEGRAM_CHAT_ID=

# ---- Reddit (P0/P3: OAuth script app under the OLD posting account) ----
SCOUT_REDDIT_CLIENT_ID=
SCOUT_REDDIT_CLIENT_SECRET=
SCOUT_REDDIT_USERNAME=
SCOUT_REDDIT_PASSWORD=          # script-app password grant — enables posting

# ---- Reddit polling ----
SCOUT_SUBREDDITS=AirBnB_Hosts,vacationrentals,propertymanagement,Innkeeping
SCOUT_POLL_INTERVAL_MIN=10
SCOUT_SCORE_THRESHOLD=4
SCOUT_SEARCH_QUERY=software OR tool OR app OR pms OR spreadsheet

# ---- DRAFT ENGINE (free tiers; chain: google → groq → cloudflare → KB) ----
SCOUT_LLM_PROVIDER=google
SCOUT_LLM_GOOGLE_MODEL=gemini-2.0-flash
SCOUT_LLM_GOOGLE_KEY=
SCOUT_LLM_GROQ_MODEL=llama-3.3-70b-versatile
SCOUT_LLM_GROQ_KEY=
SCOUT_LLM_CF_ACCOUNT_ID=
SCOUT_LLM_CF_API_TOKEN=
SCOUT_LLM_CF_MODEL=@cf/meta/llama-3.1-8b-instruct
SCOUT_KB_DIR=./kb

# ---- PER-PLATFORM CAPS (no global cap by design) ----
SCOUT_CAP_REDDIT_PER_SUB_DAY=2
SCOUT_CAP_DRAFTS_LINKEDIN_DAY=5
SCOUT_CAP_DRAFTS_X_DAY=5
SCOUT_CAP_DRAFTS_FB_DAY=5
SCOUT_CAP_EMAIL_FIRST_TOUCH_DAY=20

# ---- Quiet hours + recap/digest hours (SCOUT_TIMEZONE local) ----
SCOUT_TIMEZONE=Europe/Belgrade
SCOUT_QUIET_START=23
SCOUT_QUIET_END=7
SCOUT_RECAP_HOUR=7
SCOUT_DIGEST_HOUR=9

# ---- Draft expiry (hours) ----
SCOUT_DRAFT_EXPIRE_HOURS=48

# ---- /ingest (extension landing; LAN/Tailscale bind + token) ----
SCOUT_INGEST_DISABLED=
SCOUT_INGEST_PORT=8787
SCOUT_INGEST_BIND=127.0.0.1     # 192.168.x.x / Tailscale IP for LAN+VPN access
SCOUT_INGEST_TOKEN=             # REQUIRED if ingest opens a port at all
SCOUT_INGEST_MAX_PER_HOUR=600

# ---- Reddit posting guardrails ----
SCOUT_REMOVAL_TRIGGER=3         # removals that pause posting...
SCOUT_REMOVAL_WINDOW_DAYS=7     # ...inside this window

# ---- Lead-finder (Phase 6; OFF until enabled on the box) ----
SCOUT_LEADFINDER_ENABLED=
SCOUT_LEADFINDER_INTERVAL_DAYS=7
SCOUT_LEADFINDER_CITIES=Lisbon, Barcelona, Amsterdam, Zagreb, Split
SCOUT_LEADFINDER_MAX_PER_RUN=50

# ---- LAN web dashboard (browser access; token-gated) ----
SCOUT_DASHBOARD_DISABLED=
SCOUT_DASHBOARD_PORT=8788
SCOUT_DASHBOARD_BIND=0.0.0.0    # 0.0.0.0 = reachable from your LAN; keep 127.0.0.1 to restrict
SCOUT_DASHBOARD_TOKEN=          # empty = auto-generated on first boot, written to data/dashboard-token.txt

# ---- Kill switch (boot-level master; /stop on Telegram can set at runtime) ----
SCOUT_DISABLED=

# ---- Where the SQLite DB lives (systemd unit passes this) ----
SCOUT_DATA_DIR=./data
